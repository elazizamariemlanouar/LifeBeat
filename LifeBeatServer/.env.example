# Copiez ce fichier en ".env" puis remplissez les valeurs réelles.
# Ne JAMAIS committer le fichier ".env" (déjà exclu via .gitignore).

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me-in-production
PORT=5000

# --- Firebase ---
# Chemin vers le fichier de clé de service Firebase (JSON).
FIREBASE_CREDENTIALS_PATH=credentials/firebase-key.json
# URL de votre base Firebase Realtime Database.
FIREBASE_DATABASE_URL=https://<votre-projet>-default-rtdb.<region>.firebasedatabase.app/

# --- Machine Learning ---
ML_MODEL_PATH=ml_models/decision_tree_model1.pkl

# --- Surveillance ---
MONITORED_PATIENT=BoblEponge
MONITOR_INTERVAL_SECONDS=2

# --- Seuils médicaux ---
TEMPERATURE_HIGH_THRESHOLD=38.5
HEART_RATE_LOW_THRESHOLD=60
HEART_RATE_HIGH_THRESHOLD=100
SPO2_LOW_THRESHOLD=70

# --- Détection de pas / de chute ---
STEP_DETECTION_THRESHOLD=200
FALL_DETECTION_THRESHOLD=15
